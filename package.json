{
  "name": "wireshade",
  "version": "1.0.10",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/lib",
    "wireshade.*.node",
    "wireshade.node",
    "README.md",
    "LICENSE"
  ],
  "napi": {
    "binaryName": "wireshade",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "armv7-unknown-linux-gnueabihf"
    ]
  },
  "scripts": {
    "build": "npm run build:rs && npm run build:ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:rs": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node test.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1",
    "@types/node": "^26.1.1",
    "express": "^5.2.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lkathke/WireShade.git"
  }
}
